# IntelliBlock AI Environment Configuration Example

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="IntelliBlock AI - Railway Maintenance Block Decision-Support System"

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
# For Docker / PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/intelliblock_db
# For SQLite local dev fallback: sqlite:///./intelliblock.db
DATABASE_URL=sqlite:///./intelliblock.db

# Security & Secrets (Placeholder for future auth module)
SECRET_KEY=dev_secret_key_change_in_production_32_bytes_min
